#include <bits/stdc++.h>
using namespace std;

#define ll long long

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    ll n;
    cin>>n;
    vector<int>arr(n-1);
    ll sum=0;
    for(int i=0;i<n-1;i++){
        cin>>arr[i];
        sum+=arr[i];
    }

    ll sum1=(n*(n+1))/2;
    ll ans=sum1-sum;
    cout<<ans;

    return 0;
}
